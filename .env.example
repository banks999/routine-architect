# Copy to .env. All optional — the app runs with sensible defaults / fallbacks.
MONGO_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
# Optional: enables Gemini-generated "why this for you" blurbs. Without it, the app
# uses a rule-based template grounded in matched-skin review snippets (safe fallback).
GEMINI_API_KEY=
